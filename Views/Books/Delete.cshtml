@model SmartLibrary.Models.Book

@{
    ViewData["Title"] = "Supprimer le Livre";
}

<div class="page-header mt-3">
    <div>
        <h1>Supprimer le Livre</h1>
        <p>Êtes-vous sûr de vouloir retirer ce livre de la bibliothèque ?</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Retour à la liste
    </a>
</div>

<div class="alert alert-warning border-0 shadow-sm rounded-3 d-flex align-items-center mb-4" role="alert" style="max-width: 650px;">
    <i class="bi bi-exclamation-triangle-fill me-3 fs-3 text-warning"></i>
    <div>
        <strong>Attention !</strong> Cette action est irréversible. Supprimer ce livre supprimera également ses historiques d'emprunts.
    </div>
</div>

<div class="card border-0 shadow-sm max-w-650 mb-4">
    <div class="card-body p-4">
        <div class="d-flex align-items-start gap-3 border-bottom pb-4 mb-4">
            <div class="bg-danger bg-opacity-10 text-danger rounded-3 p-3 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                <i class="bi bi-trash fs-2"></i>
            </div>
            <div>
                <h3 class="fw-bold text-dark mb-1">@Model.Title</h3>
                <p class="text-muted mb-0">par <strong class="text-dark">@Model.Author</strong></p>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-sm-6">
                <div class="text-xs text-muted fw-semibold text-uppercase tracking-wider">Catégorie</div>
                <div class="mt-1">
                    @if (Model.Category != null)
                    {
                        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1 rounded-pill">
                            @Model.Category.Name
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </div>
            </div>

            <div class="col-sm-6">
                <div class="text-xs text-muted fw-semibold text-uppercase tracking-wider">Prix</div>
                <div class="mt-1 fw-bold text-dark">
                    @Model.Price.ToString("F2") MAD
                </div>
            </div>

            <div class="col-sm-6">
                <div class="text-xs text-muted fw-semibold text-uppercase tracking-wider">Stock restant</div>
                <div class="mt-1">
                    @Model.StockQuantity unités
                </div>
            </div>

            <div class="col-sm-6">
                <div class="text-xs text-muted fw-semibold text-uppercase tracking-wider">ID du Livre</div>
                <div class="mt-1 text-mono text-muted">
                    #@Model.Id
                </div>
            </div>
        </div>

        <form asp-action="Delete" class="border-top pt-4">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Confirmer la suppression
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
            </div>
        </form>
    </div>
</div>
