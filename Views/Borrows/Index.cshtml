@model IEnumerable<SmartLibrary.Models.Borrow>

@{
    ViewData["Title"] = "Liste des Emprunts";
}

<div class="page-header mt-3">
    <div>
        <h1>Emprunts</h1>
        <p>Historique et suivi des emprunts de livres</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">
        <i class="bi bi-journal-plus"></i> Enregistrer un emprunt
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-modern-wrapper border-0 shadow-none">
            <table class="table-modern">
                <thead>
                    <tr>
                        <th>Emprunteur</th>
                        <th>Date de Demande / d'Emprunt</th>
                        <th>Date de Retour prévue / effective</th>
                        <th>Livre(s)</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var borrow in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@borrow.BorrowerName</strong>
                                </td>
                                <td>
                                    <i class="bi bi-calendar-event text-muted me-1"></i> @borrow.BorrowDate.ToShortDateString()
                                </td>
                                <td>
                                    @if (borrow.Status == "Returned" && borrow.ReturnDate.HasValue)
                                    {
                                        <span class="text-success">
                                            <i class="bi bi-calendar-check-fill me-1"></i> @borrow.ReturnDate.Value.ToShortDateString()
                                        </span>
                                    }
                                    else if (borrow.Status == "Approved")
                                    {
                                        <span class="text-dark">
                                            <i class="bi bi-calendar-event me-1"></i> Avant le @borrow.DueDate.ToShortDateString()
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @foreach (var item in borrow.BorrowItems)
                                    {
                                        <div class="d-flex align-items-center gap-1 my-1">
                                            <i class="bi bi-book-half text-secondary fs-6"></i>
                                            <span>@(item.Book?.Title ?? "Livre inconnu")</span>
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (borrow.Status == "Pending")
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-1 fs-xs fw-semibold">
                                            <i class="bi bi-hourglass-split"></i> En attente
                                        </span>
                                    }
                                    else if (borrow.Status == "Approved")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 fs-xs fw-semibold">
                                            <i class="bi bi-book-half"></i> En cours
                                        </span>
                                    }
                                    else if (borrow.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1 fs-xs fw-semibold">
                                            <i class="bi bi-x-circle"></i> Rejeté
                                        </span>
                                    }
                                    else if (borrow.Status == "Returned")
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-1 fs-xs fw-semibold">
                                            <i class="bi bi-arrow-counterclockwise"></i> Retourné
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                    {
                                        @if (borrow.Status == "Pending")
                                        {
                                            <form asp-action="Approve" asp-route-id="@borrow.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success me-1">
                                                    <i class="bi bi-check-lg"></i> Approuver
                                                </button>
                                            </form>
                                            <form asp-action="Reject" asp-route-id="@borrow.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-x-lg"></i> Rejeter
                                                </button>
                                            </form>
                                        }
                                        else if (borrow.Status == "Approved")
                                        {
                                            <form asp-action="ReturnBook" asp-route-id="@borrow.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-primary">
                                                    <i class="bi bi-arrow-counterclockwise"></i> Rendre
                                                </button>
                                            </form>
                                        }
                                        else if (borrow.Status == "Rejected")
                                        {
                                            <span class="text-danger small"><i class="bi bi-x-circle"></i> Refusé</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><i class="bi bi-check-all text-success"></i> Retourné</span>
                                        }
                                    }
                                    else
                                    {
                                        @if (borrow.Status == "Pending")
                                        {
                                            <span class="text-warning small"><i class="bi bi-hourglass-split"></i> En attente</span>
                                        }
                                        else if (borrow.Status == "Approved")
                                        {
                                            var daysRemaining = (borrow.DueDate - DateTime.Now.Date).Days;
                                            if (daysRemaining < 0)
                                            {
                                                <span class="text-danger small fw-bold"><i class="bi bi-exclamation-triangle"></i> En retard (@Math.Abs(daysRemaining) j)</span>
                                            }
                                            else
                                            {
                                                <span class="text-success small fw-medium"><i class="bi bi-clock"></i> @daysRemaining j restants</span>
                                            }
                                        }
                                        else if (borrow.Status == "Rejected")
                                        {
                                            <span class="text-danger small"><i class="bi bi-x-circle"></i> Refusé</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><i class="bi bi-check-circle"></i> Terminé</span>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-folder-x fs-2 d-block mb-2 text-muted opacity-50"></i>
                                Aucun emprunt enregistré.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>