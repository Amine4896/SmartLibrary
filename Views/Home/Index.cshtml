@{
    ViewData["Title"] = "Dashboard";
}

<!-- ===== HERO BANNER ===== -->
<div class="lib-hero mb-4">
    <img src="~/images/library-bg.svg" alt="" class="lib-hero-img" />
    <div class="lib-hero-overlay">
        <h1 class="lib-hero-title">SmartLibrary</h1>
        <p class="lib-hero-sub">Gestion intelligente de votre bibliothèque</p>
    </div>
</div>

@if (User.Identity == null || !User.Identity.IsAuthenticated)
{
    <!-- ========================================== -->
    <!-- ===== 1. GUEST DASHBOARD (COMMON) ===== -->
    <!-- ========================================== -->
    <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, rgba(79, 70, 229, 0.08) 0%, rgba(14, 165, 233, 0.08) 100%); border: 1px solid rgba(79, 70, 229, 0.15) !important;">
        <div class="card-body p-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h3 class="fw-bold text-dark mb-1" style="font-size: 1.25rem;"><i class="bi bi-stars text-primary me-2"></i> Rejoignez SmartLibrary !</h3>
                <p class="text-muted small mb-0">Découvrez notre catalogue, réservez des livres en ligne et laissez-vous guider par notre assistant IA.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-box-arrow-in-right"></i> Se connecter
                </a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-primary">
                    <i class="bi bi-person-plus"></i> Créer un compte Client
                </a>
            </div>
        </div>
    </div>

    <!-- ===== STATS CARDS ===== -->
    <div class="sl-stats">
        <div class="sl-stat-card">
            <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                <i class="bi bi-book fs-4"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@ViewBag.TotalBooks</div>
                <div class="stat-label">Total livres</div>
            </div>
        </div>
        <div class="sl-stat-card">
            <div class="stat-icon bg-success bg-opacity-10 text-success">
                <i class="bi bi-check-circle fs-4"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@ViewBag.AvailableBooks</div>
                <div class="stat-label">Disponibles</div>
            </div>
        </div>
        <div class="sl-stat-card">
            <div class="stat-icon bg-info bg-opacity-10 text-info">
                <i class="bi bi-tags fs-4"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@ViewBag.TotalCategories</div>
                <div class="stat-label">Catégories</div>
            </div>
        </div>
    </div>

    <!-- ===== FEATURED CATALOG PREVIEW ===== -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <span style="font-weight:700; font-size:1.05rem; color:var(--dark);">
                <i class="bi bi-grid-3x3-gap text-primary me-2"></i> Aperçu du Catalogue
            </span>
        </div>
        <div class="card-body">
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @if (ViewBag.FeaturedBooks != null)
                {
                    @foreach (var book in (List<SmartLibrary.Models.Book>)ViewBag.FeaturedBooks)
                    {
                        <div class="col">
                            <div class="card h-100 border border-light-subtle shadow-sm transition-all hover-shadow-md">
                                <div class="card-body p-3.5 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-start mb-2.5">
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-2.5 py-1 fs-xs fw-semibold">
                                                @book.Category?.Name
                                            </span>
                                            @if (book.StockQuantity > 0)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2.5 py-1 fs-xs fw-semibold">
                                                    Disponible (@book.StockQuantity)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2.5 py-1 fs-xs fw-semibold">
                                                    Indisponible
                                                </span>
                                            }
                                        </div>
                                        <h5 class="fw-bold text-dark mb-1" style="font-size: 0.95rem; line-height: 1.4;">@book.Title</h5>
                                        <p class="text-muted small mb-0">par <strong>@book.Author</strong></p>
                                    </div>
                                    <div class="border-top pt-2.5 mt-3 d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-primary">@book.Price.ToString("N2") DH</span>
                                        <span class="text-muted small fs-xs">ID: #@book.Id</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="text-center mt-4">
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-box-arrow-in-right"></i> Connectez-vous pour faire des demandes d'emprunts
                </a>
            </div>
        </div>
    </div>
}
else if (User.IsInRole("Client"))
{
    <!-- ========================================== -->
    <!-- ===== 2. CLIENT DASHBOARD (AMINE)    ===== -->
    <!-- ========================================== -->
    <div class="page-header mt-3">
        <div>
            <h1>Mon Espace Lecteur</h1>
            <p>Bonjour <strong>@User.Identity?.Name</strong>, voici l'état de vos demandes et emprunts</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-controller="Borrows" asp-action="Create">
                <i class="bi bi-journal-plus"></i> Nouvelle demande d'emprunt
            </a>
            <a class="btn btn-outline-secondary" asp-controller="Books" asp-action="Index">
                <i class="bi bi-search"></i> Parcourir les livres
            </a>
        </div>
    </div>

    <!-- ===== STATS CARDS ===== -->
    <div class="sl-stats">
        <div class="sl-stat-card">
            <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                <i class="bi bi-list-stars fs-4"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@ViewBag.TotalClientBorrows</div>
                <div class="stat-label">Total demandes</div>
            </div>
        </div>
        <div class="sl-stat-card">
            <div class="stat-icon bg-success bg-opacity-10 text-success">
                <i class="bi bi-book-half fs-4"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@ViewBag.ActiveClientBorrows</div>
                <div class="stat-label">Emprunts actifs</div>
            </div>
        </div>
        <div class="sl-stat-card">
            <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                <i class="bi bi-hourglass-split fs-4"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@ViewBag.PendingClientBorrows</div>
                <div class="stat-label">En attente</div>
            </div>
        </div>
    </div>

    <!-- ===== MY BORROWS TABLE ===== -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <span style="font-weight:700; font-size:1.05rem; color:var(--dark);">
                <i class="bi bi-journal-bookmark text-primary me-2"></i> Mes Emprunts et Demandes
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-modern-wrapper border-0 shadow-none">
                <table class="table-modern">
                    <thead>
                        <tr>
                            <th>Livre(s)</th>
                            <th>Date de demande</th>
                            <th>Retour prévu / effectif</th>
                            <th>Statut</th>
                            <th>Temps Restant</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.UserBorrows != null && ((List<SmartLibrary.Models.Borrow>)ViewBag.UserBorrows).Any())
                        {
                            @foreach (var borrow in (List<SmartLibrary.Models.Borrow>)ViewBag.UserBorrows)
                            {
                                <tr>
                                    <td>
                                        @if (borrow.BorrowItems != null && borrow.BorrowItems.Any())
                                        {
                                            <strong>@string.Join(", ", borrow.BorrowItems.Select(bi => bi.Book?.Title ?? "Livre inconnu"))</strong>
                                            <div class="text-muted small">de @string.Join(", ", borrow.BorrowItems.Select(bi => bi.Book?.Author ?? "Auteur inconnu"))</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Aucun livre</span>
                                        }
                                    </td>
                                    <td>
                                        <i class="bi bi-calendar me-1"></i> @borrow.BorrowDate.ToShortDateString()
                                    </td>
                                    <td>
                                        @if (borrow.Status == "Returned" && borrow.ReturnDate.HasValue)
                                        {
                                            <span class="text-success"><i class="bi bi-calendar-check me-1"></i> Retourné le @borrow.ReturnDate.Value.ToShortDateString()</span>
                                        }
                                        else if (borrow.Status == "Approved")
                                        {
                                            <span class="text-dark"><i class="bi bi-calendar-event me-1"></i> À retourner avant le @borrow.DueDate.ToShortDateString()</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (borrow.Status == "Pending")
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-1 fs-xs fw-semibold">
                                                <i class="bi bi-hourglass-split"></i> En attente
                                            </span>
                                        }
                                        else if (borrow.Status == "Approved")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 fs-xs fw-semibold">
                                                <i class="bi bi-check-circle"></i> En cours
                                            </span>
                                        }
                                        else if (borrow.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1 fs-xs fw-semibold">
                                                <i class="bi bi-x-circle"></i> Rejeté
                                            </span>
                                        }
                                        else if (borrow.Status == "Returned")
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-1 fs-xs fw-semibold">
                                                <i class="bi bi-arrow-counterclockwise"></i> Retourné
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (borrow.Status == "Approved")
                                        {
                                            var daysRemaining = (borrow.DueDate - DateTime.Now.Date).Days;
                                            if (daysRemaining < 0)
                                            {
                                                <span class="text-danger fw-bold"><i class="bi bi-exclamation-triangle-fill"></i> En retard de @Math.Abs(daysRemaining) jour(s)</span>
                                            }
                                            else
                                            {
                                                <span class="text-success fw-medium"><i class="bi bi-clock"></i> @daysRemaining jour(s) restant(s)</span>
                                            }
                                        }
                                        else if (borrow.Status == "Pending")
                                        {
                                            <span class="text-muted small">Attente de validation</span>
                                        }
                                        else if (borrow.Status == "Rejected")
                                        {
                                            <span class="text-danger small">Demande refusée</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Terminé</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (borrow.Status == "Approved")
                                        {
                                            <form asp-controller="Borrows" asp-action="ReturnBook" asp-route-id="@borrow.Id" method="post" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir rendre ce livre ?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-primary px-3 py-1">
                                                    <i class="bi bi-arrow-counterclockwise"></i> Rendre le livre
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 text-muted opacity-50"></i>
                                    Vous n'avez pas encore fait de demande d'emprunt.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else if (User.IsInRole("Manager"))
{
    <!-- ========================================== -->
    <!-- ===== 3. MANAGER DASHBOARD           ===== -->
    <!-- ========================================== -->
    <div class="page-header mt-3">
        <div>
            <h1>Espace Gestionnaire</h1>
            <p>Bienvenue <strong>@User.Identity?.Name</strong> (Manager) — Gestion de l'inventaire et des validations</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-controller="Borrows" asp-action="Create">
                <i class="bi bi-journal-plus"></i> Enregistrer un emprunt
            </a>
            <a class="btn btn-primary" asp-controller="Books" asp-action="Create">
                <i class="bi bi-plus-lg"></i> Ajouter un livre
            </a>
        </div>
    </div>

    <!-- ===== STATS CARDS ===== -->
    <div class="sl-stats">
        <div class="sl-stat-card">
            <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                <i class="bi bi-book fs-4"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@ViewBag.TotalBooks</div>
                <div class="stat-label">Total livres</div>
            </div>
        </div>
        <div class="sl-stat-card">
            <div class="stat-icon bg-success bg-opacity-10 text-success">
                <i class="bi bi-check-circle fs-4"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@ViewBag.AvailableBooks</div>
                <div class="stat-label">Disponibles</div>
            </div>
        </div>
        <div class="sl-stat-card">
            <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                <i class="bi bi-arrow-up-right-circle fs-4"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@ViewBag.BorrowedBooks</div>
                <div class="stat-label">Emprunts actifs</div>
            </div>
        </div>
        <div class="sl-stat-card">
            <div class="stat-icon bg-info bg-opacity-10 text-info">
                <i class="bi bi-tags fs-4"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@ViewBag.TotalCategories</div>
                <div class="stat-label">Catégories</div>
            </div>
        </div>
    </div>

    <!-- ===== PENDING REQUESTS PANEL ===== -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <span style="font-weight:700; font-size:1.05rem; color:var(--dark);">
                <i class="bi bi-bell text-warning me-2 animate-bounce"></i> Demandes d'emprunts en attente
            </span>
            <span class="badge bg-warning text-dark rounded-pill px-2.5 py-1">@(((List<SmartLibrary.Models.Borrow>)ViewBag.PendingBorrows)?.Count ?? 0) demandes</span>
        </div>
        <div class="card-body p-0">
            <div class="table-modern-wrapper border-0 shadow-none">
                <table class="table-modern">
                    <thead>
                        <tr>
                            <th>Livre(s) demandé(s)</th>
                            <th>Lecteur (Client)</th>
                            <th>Date de demande</th>
                            <th class="text-end">Actions rapides</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.PendingBorrows != null && ((List<SmartLibrary.Models.Borrow>)ViewBag.PendingBorrows).Any())
                        {
                            @foreach (var borrow in (List<SmartLibrary.Models.Borrow>)ViewBag.PendingBorrows)
                            {
                                <tr>
                                    <td>
                                        @if (borrow.BorrowItems != null && borrow.BorrowItems.Any())
                                        {
                                            <strong>@string.Join(", ", borrow.BorrowItems.Select(bi => bi.Book?.Title ?? "Livre inconnu"))</strong>
                                            <div class="text-muted small">de @string.Join(", ", borrow.BorrowItems.Select(bi => bi.Book?.Author ?? "Auteur inconnu")) (Stock: @string.Join(", ", borrow.BorrowItems.Select(bi => bi.Book?.StockQuantity.ToString() ?? "0")))</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Aucun livre</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="text-dark fw-semibold">@borrow.BorrowerName</span>
                                    </td>
                                    <td>
                                        <i class="bi bi-calendar me-1"></i> @borrow.BorrowDate.ToShortDateString()
                                    </td>
                                    <td class="text-end">
                                        <form asp-controller="Borrows" asp-action="Approve" asp-route-id="@borrow.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success me-1">
                                                <i class="bi bi-check-lg"></i> Approuver
                                            </button>
                                        </form>
                                        <form asp-controller="Borrows" asp-action="Reject" asp-route-id="@borrow.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-x-lg"></i> Rejeter
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    <i class="bi bi-clipboard-check fs-3 d-block mb-2 text-muted opacity-50"></i>
                                    Aucune demande en attente d'approbation.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ===== RECENT BORROWS ===== -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
            <span style="font-weight:700; font-size:1.05rem; color:var(--dark);">
                <i class="bi bi-clock-history text-primary me-2"></i> Historique des emprunts récents
            </span>
            <a asp-controller="Borrows" asp-action="Index" class="btn btn-sm btn-outline-secondary">Voir tout</a>
        </div>
        <div class="card-body p-0">
            <div class="table-modern-wrapper border-0 shadow-none">
                <table class="table-modern">
                    <thead>
                        <tr>
                            <th>Livre(s)</th>
                            <th>Emprunteur</th>
                            <th>Date limite / effective</th>
                            <th>Statut</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.RecentBorrows != null && ((List<SmartLibrary.Models.Borrow>)ViewBag.RecentBorrows).Any())
                        {
                            @foreach (var borrow in (List<SmartLibrary.Models.Borrow>)ViewBag.RecentBorrows)
                            {
                                <tr>
                                    <td>
                                        @if (borrow.BorrowItems != null && borrow.BorrowItems.Any())
                                        {
                                            <strong>@string.Join(", ", borrow.BorrowItems.Select(bi => bi.Book?.Title ?? "Livre inconnu"))</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Aucun livre</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="text-dark font-medium">@borrow.BorrowerName</span>
                                    </td>
                                    <td>
                                        @if (borrow.Status == "Returned" && borrow.ReturnDate.HasValue)
                                        {
                                            <span class="text-success"><i class="bi bi-calendar-check me-1"></i> Retourné le @borrow.ReturnDate.Value.ToShortDateString()</span>
                                        }
                                        else if (borrow.Status == "Approved")
                                        {
                                            <span class="text-muted"><i class="bi bi-calendar-x me-1"></i> Avant le @borrow.DueDate.ToShortDateString()</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (borrow.Status == "Pending")
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-1 fs-xs fw-semibold">En attente</span>
                                        }
                                        else if (borrow.Status == "Approved")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 fs-xs fw-semibold">En cours</span>
                                        }
                                        else if (borrow.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1 fs-xs fw-semibold">Rejeté</span>
                                        }
                                        else if (borrow.Status == "Returned")
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-1 fs-xs fw-semibold">Retourné</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (borrow.Status == "Approved")
                                        {
                                            <form asp-controller="Borrows" asp-action="ReturnBook" asp-route-id="@borrow.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-primary">
                                                    <i class="bi bi-arrow-counterclockwise"></i> Rendre
                                                </button>
                                            </form>
                                        }
                                        else if (borrow.Status == "Pending")
                                        {
                                            <form asp-controller="Borrows" asp-action="Approve" asp-route-id="@borrow.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="bi bi-check-lg"></i> Approuver
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" disabled>
                                                <i class="bi bi-check-lg"></i> Terminé
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 text-muted opacity-50"></i>
                                    Aucun emprunt enregistré.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else if (User.IsInRole("Admin"))
{
    <!-- ========================================== -->
    <!-- ===== 4. ADMIN DASHBOARD             ===== -->
    <!-- ========================================== -->
    <div class="page-header mt-3">
        <div>
            <h1>Console d'Administration</h1>
            <p>Bienvenue <strong>@User.Identity?.Name</strong> (Super-Administrateur) — Supervision complète et statistiques</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-controller="Borrows" asp-action="Create">
                <i class="bi bi-journal-plus"></i> Enregistrer un emprunt
            </a>
            <a class="btn btn-primary" asp-controller="Users" asp-action="Index">
                <i class="bi bi-people"></i> Gérer les Managers
            </a>
        </div>
    </div>

    <!-- ===== STATS CARDS ===== -->
    <div class="sl-stats">
        <div class="sl-stat-card">
            <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                <i class="bi bi-book fs-4"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@ViewBag.TotalBooks</div>
                <div class="stat-label">Total livres</div>
            </div>
        </div>
        <div class="sl-stat-card">
            <div class="stat-icon bg-success bg-opacity-10 text-success">
                <i class="bi bi-check-circle fs-4"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@ViewBag.AvailableBooks</div>
                <div class="stat-label">Disponibles</div>
            </div>
        </div>
        <div class="sl-stat-card">
            <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                <i class="bi bi-arrow-up-right-circle fs-4"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@ViewBag.BorrowedBooks</div>
                <div class="stat-label">Emprunts actifs</div>
            </div>
        </div>
        <div class="sl-stat-card">
            <div class="stat-icon bg-info bg-opacity-10 text-info">
                <i class="bi bi-tags fs-4"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@ViewBag.TotalCategories</div>
                <div class="stat-label">Catégories</div>
            </div>
        </div>
    </div>

    <!-- ===== PENDING REQUESTS PANEL ===== -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <span style="font-weight:700; font-size:1.05rem; color:var(--dark);">
                <i class="bi bi-bell text-warning me-2 animate-bounce"></i> Demandes d'emprunts en attente
            </span>
            <span class="badge bg-warning text-dark rounded-pill px-2.5 py-1">@(((List<SmartLibrary.Models.Borrow>)ViewBag.PendingBorrows)?.Count ?? 0) demandes</span>
        </div>
        <div class="card-body p-0">
            <div class="table-modern-wrapper border-0 shadow-none">
                <table class="table-modern">
                    <thead>
                        <tr>
                            <th>Livre(s) demandé(s)</th>
                            <th>Lecteur (Client)</th>
                            <th>Date de demande</th>
                            <th class="text-end">Actions rapides</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.PendingBorrows != null && ((List<SmartLibrary.Models.Borrow>)ViewBag.PendingBorrows).Any())
                        {
                            @foreach (var borrow in (List<SmartLibrary.Models.Borrow>)ViewBag.PendingBorrows)
                            {
                                <tr>
                                    <td>
                                        @if (borrow.BorrowItems != null && borrow.BorrowItems.Any())
                                        {
                                            <strong>@string.Join(", ", borrow.BorrowItems.Select(bi => bi.Book?.Title ?? "Livre inconnu"))</strong>
                                            <div class="text-muted small">de @string.Join(", ", borrow.BorrowItems.Select(bi => bi.Book?.Author ?? "Auteur inconnu")) (Stock: @string.Join(", ", borrow.BorrowItems.Select(bi => bi.Book?.StockQuantity.ToString() ?? "0")))</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Aucun livre</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="text-dark fw-semibold">@borrow.BorrowerName</span>
                                    </td>
                                    <td>
                                        <i class="bi bi-calendar me-1"></i> @borrow.BorrowDate.ToShortDateString()
                                    </td>
                                    <td class="text-end">
                                        <form asp-controller="Borrows" asp-action="Approve" asp-route-id="@borrow.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success me-1">
                                                <i class="bi bi-check-lg"></i> Approuver
                                            </button>
                                        </form>
                                        <form asp-controller="Borrows" asp-action="Reject" asp-route-id="@borrow.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-x-lg"></i> Rejeter
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    <i class="bi bi-clipboard-check fs-3 d-block mb-2 text-muted opacity-50"></i>
                                    Aucune demande en attente d'approbation.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ===== RECENT BORROWS ===== -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
            <span style="font-weight:700; font-size:1.05rem; color:var(--dark);">
                <i class="bi bi-clock-history text-primary me-2"></i> Historique des emprunts récents
            </span>
            <a asp-controller="Borrows" asp-action="Index" class="btn btn-sm btn-outline-secondary">Voir tout</a>
        </div>
        <div class="card-body p-0">
            <div class="table-modern-wrapper border-0 shadow-none">
                <table class="table-modern">
                    <thead>
                        <tr>
                            <th>Livre(s)</th>
                            <th>Emprunteur</th>
                            <th>Date limite / effective</th>
                            <th>Statut</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.RecentBorrows != null && ((List<SmartLibrary.Models.Borrow>)ViewBag.RecentBorrows).Any())
                        {
                            @foreach (var borrow in (List<SmartLibrary.Models.Borrow>)ViewBag.RecentBorrows)
                            {
                                <tr>
                                    <td>
                                        @if (borrow.BorrowItems != null && borrow.BorrowItems.Any())
                                        {
                                            <strong>@string.Join(", ", borrow.BorrowItems.Select(bi => bi.Book?.Title ?? "Livre inconnu"))</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Aucun livre</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="text-dark font-medium">@borrow.BorrowerName</span>
                                    </td>
                                    <td>
                                        @if (borrow.Status == "Returned" && borrow.ReturnDate.HasValue)
                                        {
                                            <span class="text-success"><i class="bi bi-calendar-check me-1"></i> Retourné le @borrow.ReturnDate.Value.ToShortDateString()</span>
                                        }
                                        else if (borrow.Status == "Approved")
                                        {
                                            <span class="text-muted"><i class="bi bi-calendar-x me-1"></i> Avant le @borrow.DueDate.ToShortDateString()</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (borrow.Status == "Pending")
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-1 fs-xs fw-semibold">En attente</span>
                                        }
                                        else if (borrow.Status == "Approved")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 fs-xs fw-semibold">En cours</span>
                                        }
                                        else if (borrow.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1 fs-xs fw-semibold">Rejeté</span>
                                        }
                                        else if (borrow.Status == "Returned")
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-1 fs-xs fw-semibold">Retourné</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (borrow.Status == "Approved")
                                        {
                                            <form asp-controller="Borrows" asp-action="ReturnBook" asp-route-id="@borrow.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-primary">
                                                    <i class="bi bi-arrow-counterclockwise"></i> Rendre
                                                </button>
                                            </form>
                                        }
                                        else if (borrow.Status == "Pending")
                                        {
                                            <form asp-controller="Borrows" asp-action="Approve" asp-route-id="@borrow.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="bi bi-check-lg"></i> Approuver
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" disabled>
                                                <i class="bi bi-check-lg"></i> Terminé
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 text-muted opacity-50"></i>
                                    Aucun emprunt enregistré.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ===== ADMIN CONSOLE & STATISTICS ===== -->
    <div class="row g-4 mb-4 mt-3">
        <!-- Daily Stats Chart & Details -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <span style="font-weight:700; font-size:1.05rem; color:var(--dark);">
                        <i class="bi bi-graph-up-arrow text-primary me-2"></i> Statistiques Financières & Activité Journalière
                    </span>
                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2.5 py-1">10 Derniers Jours</span>
                </div>
                <div class="card-body">
                    <!-- Chart container -->
                    <div class="mb-4" style="position: relative; height:240px; width:100%">
                        <canvas id="dailyStatsChart"></canvas>
                    </div>
                    
                    <!-- Table of daily details -->
                    <div class="table-modern-wrapper border-0 shadow-none">
                        <table class="table-modern">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th class="text-center">Livres Empruntés</th>
                                    <th class="text-end">Revenus Générés</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.DailyStats != null && ((List<SmartLibrary.Models.DailyRevenueViewModel>)ViewBag.DailyStats).Any())
                                {
                                    @foreach (var stat in (List<SmartLibrary.Models.DailyRevenueViewModel>)ViewBag.DailyStats)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@stat.Date.ToString("dd/MM/yyyy")</td>
                                            <td class="text-center">
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-2.5 py-1">
                                                    @stat.BorrowedBooksCount livre(s)
                                                </span>
                                            </td>
                                            <td class="text-end fw-bold text-success">@stat.Revenue.ToString("N2") DH</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-4">
                                            Aucune donnée financière pour le moment.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Admin System Controls -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100" style="border: 1px solid rgba(239, 68, 68, 0.15) !important;">
                <div class="card-header bg-white border-bottom py-3">
                    <span style="font-weight:700; font-size:1.05rem; color:var(--dark);">
                        <i class="bi bi-cpu text-danger me-2"></i> Console d'Administration
                    </span>
                </div>
                <div class="card-body d-flex flex-column justify-content-between" style="min-height: 330px;">
                    <div>
                        <h5 class="fw-bold text-dark mb-2" style="font-size: 1rem;">Contrôle du Serveur Web</h5>
                        <p class="text-muted small mb-3">
                            En tant qu'administrateur, vous pouvez éteindre le serveur web de l'application de manière sécurisée. Cette action fermera toutes les connexions actives et arrêtera le service.
                        </p>
                        
                        <div class="alert alert-warning border-0 small py-2.5 mb-4" style="background-color: rgba(245, 158, 11, 0.1); color: var(--warning); border-radius: 8px;">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            <strong>Attention :</strong> L'arrêt du serveur désactivera l'accès à SmartLibrary pour tous les utilisateurs jusqu'au redémarrage manuel.
                        </div>
                    </div>

                    <div>
                        <form asp-controller="Home" asp-action="StopApp" method="post" onsubmit="return confirm('Êtes-vous sûr de vouloir arrêter le serveur web de l\'application ? Toutes les sessions actives seront interrompues.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger w-100 py-2.5">
                                    <i class="bi bi-power fs-5 me-1"></i> Arrêter l'Application
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (User.IsInRole("Admin"))
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                var ctx = document.getElementById('dailyStatsChart').getContext('2d');
                
                var dates = [];
                var borrowCounts = [];
                var revenues = [];

                @if (ViewBag.DailyStats != null)
                {
                    var reversedStats = ((List<SmartLibrary.Models.DailyRevenueViewModel>)ViewBag.DailyStats).AsEnumerable().Reverse().ToList();
                    @foreach (var stat in reversedStats)
                    {
                        @:dates.push("@stat.Date.ToString("dd/MM")");
                        @:borrowCounts.push(@stat.BorrowedBooksCount);
                        @:revenues.push(@stat.Revenue.ToString(System.Globalization.CultureInfo.InvariantCulture));
                    }
                }

                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: dates,
                        datasets: [
                            {
                                label: 'Livres Empruntés',
                                data: borrowCounts,
                                backgroundColor: 'rgba(79, 70, 229, 0.75)',
                                borderColor: '#4f46e5',
                                borderWidth: 1,
                                yAxisID: 'y'
                            },
                            {
                                label: 'Revenus (DH)',
                                data: revenues,
                                type: 'line',
                                fill: false,
                                backgroundColor: 'rgba(16, 185, 129, 0.8)',
                                borderColor: '#10b981',
                                borderWidth: 2,
                                tension: 0.3,
                                yAxisID: 'y1'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false,
                        },
                        scales: {
                            y: {
                                type: 'linear',
                                display: true,
                                position: 'left',
                                title: {
                                    display: true,
                                    text: 'Nombre de livres',
                                    color: '#64748b',
                                    font: { size: 10, weight: 'bold' }
                                },
                                ticks: {
                                    stepSize: 1,
                                    color: '#64748b'
                                },
                                grid: {
                                    drawOnChartArea: true,
                                    color: 'rgba(0, 0, 0, 0.05)'
                                }
                            },
                            y1: {
                                type: 'linear',
                                display: true,
                                position: 'right',
                                title: {
                                    display: true,
                                    text: 'Revenus (DH)',
                                    color: '#64748b',
                                    font: { size: 10, weight: 'bold' }
                                },
                                ticks: {
                                    color: '#64748b'
                                },
                                grid: {
                                    drawOnChartArea: false,
                                }
                            },
                            x: {
                                ticks: {
                                    color: '#64748b'
                                },
                                grid: {
                                    display: false
                                }
                            }
                        },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: {
                                    boxWidth: 12,
                                    font: { family: 'Plus Jakarta Sans', size: 11, weight: '600' },
                                    color: '#334155'
                                }
                            },
                            tooltip: {
                                backgroundColor: '#0f172a',
                                titleColor: '#ffffff',
                                bodyColor: '#ffffff',
                                padding: 10,
                                cornerRadius: 8,
                                font: { family: 'Plus Jakarta Sans' }
                            }
                        }
                    }
                });
            });
        </script>
    }
}
