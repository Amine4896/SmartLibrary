@model List<SmartLibrary.Models.Book>

@{
    ViewData["Title"] = "Livres";
}

<div class="page-header mt-3">
    <div>
        <h1>Livres</h1>
        <p>@Model.Count livre(s) référencé(s) dans la bibliothèque</p>
    </div>
    @if (User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Manager")))
    {
        <a class="btn btn-primary" asp-action="Create">
            <i class="bi bi-plus-lg"></i> Nouveau livre
        </a>
    }
</div>

<!-- Search Form -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-9 col-sm-8">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchString" placeholder="Rechercher par titre ou auteur..." class="form-control border-start-0" value="@Context.Request.Query["searchString"]" />
                </div>
            </div>
            <div class="col-md-3 col-sm-4 d-grid">
                <button type="submit" class="btn btn-primary">
                    Rechercher
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Books Grid / Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-book fs-1 d-block mb-3 opacity-50 text-muted"></i>
                <p class="mb-0">Aucun livre enregistré ou correspondant à votre recherche.</p>
                <a asp-action="Create" class="btn btn-primary mt-3">Ajouter un livre</a>
            </div>
        }
        else
        {
            <div class="table-modern-wrapper border-0 shadow-none">
                <table class="table-modern">
                    <thead>
                        <tr>
                            <th>Titre</th>
                            <th>Auteur</th>
                            <th>Catégorie</th>
                            <th>Prix</th>
                            <th>Stock</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model)
                        {
                            <tr>
                                <td><strong>@book.Title</strong></td>
                                <td>@book.Author</td>
                                <td>
                                    @if (book.Category != null)
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1 rounded-pill">
                                            @book.Category.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@book.Price.ToString("F2") MAD</span>
                                </td>
                                <td>
                                    @if (book.StockQuantity > 0)
                                    {
                                        <span class="badge-available">
                                            <i class="bi bi-check-lg"></i> @book.StockQuantity disponibles
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-borrowed">
                                            <i class="bi bi-x-circle"></i> Épuisé
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-pencil"></i> Modifier
                                            </a>
                                        }
                                        <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-eye"></i> Détails
                                        </a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> Suppr.
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
