@model IEnumerable<SmartLibrary.Models.User>

@{
    ViewData["Title"] = "Gestion des Managers";
}

<div class="page-header mt-3">
    <div>
        <h1>Gestion des Managers</h1>
        <p>Créer, modifier et supprimer les comptes d'accès pour les Managers de la bibliothèque</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">
        <i class="bi bi-person-plus"></i> Nouveau Manager
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-modern-wrapper border-0 shadow-none">
            <table class="table-modern">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom d'utilisateur</th>
                        <th>Rôle</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <span class="text-muted text-mono">#@user.Id</span>
                                </td>
                                <td>
                                    <strong>@user.Username</strong>
                                </td>
                                <td>
                                    <span class="badge bg-info bg-opacity-10 text-info px-3 py-1 rounded-pill fw-medium">
                                        <i class="bi bi-person-gear"></i> @user.Role
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-pencil"></i> Modifier
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Supprimer
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-2 d-block mb-2 text-muted opacity-50"></i>
                                Aucun compte Manager configuré pour le moment.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
