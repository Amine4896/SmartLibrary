@model IEnumerable<SmartLibrary.Models.ActivityLog>

@{
    ViewData["Title"] = "Journal d'Activité";
}

<div class="page-header mt-3">
    <div>
        <h1>Journal d'Activité</h1>
        <p>Historique complet des actions effectuées sur l'application (Audit Admin)</p>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <span style="font-weight:700; font-size:1.05rem; color:var(--dark);">
            <i class="bi bi-clock-history text-primary me-2"></i> Traces d'activité de l'application
        </span>
        <span class="badge bg-primary text-white rounded-pill px-3 py-1 fw-semibold">@Model.Count() événements</span>
    </div>
    <div class="card-body p-0">
        <div class="table-modern-wrapper border-0 shadow-none">
            <table class="table-modern">
                <thead>
                    <tr>
                        <th style="width: 180px;">Date & Heure</th>
                        <th>Utilisateur</th>
                        <th>Rôle</th>
                        <th>Action effectuée</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="text-muted small">
                                    <i class="bi bi-calendar3 me-1"></i> @log.Timestamp.ToString("g")
                                </td>
                                <td>
                                    <span class="text-dark fw-bold">@log.Username</span>
                                    @if (log.UserId.HasValue)
                                    {
                                        <span class="text-muted small d-block">ID: @log.UserId.Value</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger small d-block">Compte supprimé</span>
                                    }
                                </td>
                                <td>
                                    @if (log.UserRole == "Admin")
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2.5 py-1 fs-xs fw-semibold">
                                            Admin
                                        </span>
                                    }
                                    else if (log.UserRole == "Manager")
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-2.5 py-1 fs-xs fw-semibold">
                                            Manager
                                        </span>
                                    }
                                    else if (log.UserRole == "Client")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2.5 py-1 fs-xs fw-semibold">
                                            Client
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-2.5 py-1 fs-xs fw-semibold">
                                            @log.UserRole
                                        </span>
                                    }
                                </td>
                                <td class="text-dark fw-medium">
                                    @log.Action
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-journal-x fs-2 d-block mb-2 text-muted opacity-50"></i>
                                Aucun enregistrement d'activité trouvé dans la base de données.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
