@model SmartLibrary.Models.Book

@{
    ViewData["Title"] = "Détails du Livre";
}

<div class="page-header mt-3">
    <div>
        <h1>Détails du Livre</h1>
        <p>Fiche d'information détaillée pour "@Model.Title"</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Retour à la liste
    </a>
</div>

<div class="card border-0 shadow-sm max-w-650">
    <div class="card-body p-4">
        <div class="d-flex align-items-start gap-3 border-bottom pb-4 mb-4">
            <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                <i class="bi bi-book fs-2"></i>
            </div>
            <div>
                <h3 class="fw-bold text-dark mb-1">@Model.Title</h3>
                <p class="text-muted mb-0">par <strong class="text-dark">@Model.Author</strong></p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-sm-6">
                <div class="text-xs text-muted fw-semibold text-uppercase tracking-wider">Catégorie</div>
                <div class="mt-1">
                    @if (Model.Category != null)
                    {
                        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1 rounded-pill fw-medium">
                            @Model.Category.Name
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </div>
            </div>

            <div class="col-sm-6">
                <div class="text-xs text-muted fw-semibold text-uppercase tracking-wider">Prix de référence</div>
                <div class="mt-1 fw-bold text-dark">
                    @Model.Price.ToString("F2") MAD
                </div>
            </div>

            <div class="col-sm-6">
                <div class="text-xs text-muted fw-semibold text-uppercase tracking-wider">Disponibilité du stock</div>
                <div class="mt-1">
                    @if (Model.StockQuantity > 0)
                    {
                        <span class="badge-available">
                            <i class="bi bi-check-lg"></i> @Model.StockQuantity disponibles
                        </span>
                    }
                    else
                    {
                        <span class="badge-borrowed">
                            <i class="bi bi-x-circle"></i> En rupture de stock
                        </span>
                    }
                </div>
            </div>

            <div class="col-sm-6">
                <div class="text-xs text-muted fw-semibold text-uppercase tracking-wider">ID unique du livre</div>
                <div class="mt-1 text-mono text-muted">
                    #@Model.Id
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-5 border-top pt-4">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Modifier le livre
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">Retour</a>
        </div>
    </div>
</div>
