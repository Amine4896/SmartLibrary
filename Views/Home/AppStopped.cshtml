@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Application Arrêtée — SmartLibrary</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --dark: #0f172a;
            --light: #f8fafc;
            --danger: #ef4444;
            --border: rgba(255, 255, 255, 0.08);
        }
        body {
            background-color: var(--dark);
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            padding: 1rem;
            overflow: hidden;
        }
        .stopped-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(16px);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 3rem 2rem;
            text-align: center;
            max-width: 500px;
            width: 100%;
            box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.3), 0 8px 10px -6px rgb(0 0 0 / 0.3);
            animation: floatIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        .stopped-icon {
            font-size: 4rem;
            color: var(--danger);
            margin-bottom: 1.5rem;
            display: inline-block;
            animation: pulseIcon 2s infinite ease-in-out;
        }
        .stopped-title {
            font-size: 1.75rem;
            font-weight: 700;
            margin-bottom: 1rem;
            letter-spacing: -0.02em;
        }
        .stopped-text {
            color: #94a3b8;
            font-size: 0.95rem;
            line-height: 1.6;
            margin-bottom: 2rem;
        }
        .stopped-badge {
            background: rgba(239, 68, 68, 0.15);
            color: var(--danger);
            border: 1px solid rgba(239, 68, 68, 0.3);
            padding: 0.35rem 1rem;
            border-radius: 99px;
            font-weight: 600;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            display: inline-block;
            margin-bottom: 1rem;
        }
        .close-hint {
            font-size: 0.8rem;
            color: #64748b;
        }
        @@keyframes floatIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        @@keyframes pulseIcon {
            0%, 100% {
                transform: scale(1);
                opacity: 1;
            }
            50% {
                transform: scale(1.05);
                opacity: 0.8;
            }
        }
    </style>
</head>
<body>
    <div class="stopped-card">
        <div class="stopped-icon">
            <i class="bi bi-power"></i>
        </div>
        <div class="stopped-badge">Hors Ligne</div>
        <h1 class="stopped-title">Application Arrêtée</h1>
        <p class="stopped-text">
            Le serveur web de <strong>SmartLibrary</strong> a été éteint avec succès par l'administrateur. Toutes les connexions de base de données ont été libérées.
        </p>
        <p class="close-hint">
            <i class="bi bi-info-circle me-1"></i> Vous pouvez fermer cet onglet de navigateur.
        </p>
    </div>
</body>
</html>
