@model ChatViewModel

<h2>AI Assistant</h2>

<form asp-action="Ask" method="post">

    <textarea asp-for="Question"
              class="form-control">
    </textarea>

    <br />

    <button class="btn btn-primary">
        Ask AI
    </button>

</form>

@if (!string.IsNullOrEmpty(Model?.Response))
{
    <div class="alert alert-success mt-3">
        @Model.Response
    </div>
}