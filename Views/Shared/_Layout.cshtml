<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] — SmartLibrary</title>
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/SmartLibrary.styles.css" asp-append-version="true" />
</head>
<body>

  <header>
    <nav class="navbar navbar-expand-md">
      <div class="container">

        <!-- Brand -->
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
          <i class="bi bi-book-half text-primary"></i> SmartLibrary
        </a>

        <!-- Mobile toggle -->
        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse" data-bs-target="#navbarMain"
                aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Links -->
        <div class="collapse navbar-collapse" id="navbarMain">
          <ul class="navbar-nav me-auto mb-2 mb-md-0">
            <li class="nav-item">
              <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                 asp-controller="Home" asp-action="Index">Dashboard</a>
            </li>
            <li class="nav-item">
              <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Books" ? "active" : "")"
                 asp-controller="Books" asp-action="Index">Livres</a>
            </li>
            <li class="nav-item">
              <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")"
                 asp-controller="Categories" asp-action="Index">Catégories</a>
            </li>
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <li class="nav-item">
                  <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Borrows" ? "active" : "")"
                     asp-controller="Borrows" asp-action="Index">Emprunts</a>
                </li>
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                      <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                         asp-controller="Users" asp-action="Index">Managers</a>
                    </li>
                    <li class="nav-item">
                      <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" && ViewContext.RouteData.Values["action"]?.ToString() == "Logs" ? "active" : "")"
                         asp-controller="Users" asp-action="Logs">Journal d'activité</a>
                    </li>
                }
            }
            <li class="nav-item">
              <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Chat" ? "active" : "")"
                 asp-controller="Chat" asp-action="Index">Assistant IA</a>
            </li>
          </ul>
        </div>

        <!-- Authentification -->
        <div class="d-flex align-items-center gap-2">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
                var isAdmin = role == "Admin";
                <span class="text-white small me-2 d-none d-lg-inline">
                    Bonjour, <strong>@User.Identity.Name</strong> 
                    <span class="badge @(isAdmin ? "bg-danger" : "bg-info") bg-opacity-25 text-white rounded-pill px-2 ms-1">
                        @role
                    </span>
                </span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-light">
                        <i class="bi bi-box-arrow-right"></i> Déconnexion
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-primary">
                    <i class="bi bi-box-arrow-in-right"></i> Connexion
                </a>
            }
        </div>

      </div>
    </nav>
  </header>

  <div class="container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mt-3 d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mt-3 d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <main role="main" class="pb-3">
      @RenderBody()
    </main>
  </div>

  <footer class="footer">
    <div class="container d-flex justify-content-between align-items-center">
      <span>&copy; @DateTime.Now.Year SmartLibrary</span>
      <a asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
  </footer>

  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>